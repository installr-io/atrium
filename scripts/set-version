#!/bin/bash

WORKDIR=$(realpath $(dirname $0)/..)
FORMAT='^[0-9]+([.][0-9]+){2}(-SNAPSHOT)?$'

if [[ ${#@} != 1 ]]; then
    echo "usage: $0 <version>"
    exit 1
fi
VERSION=$1

if ! [[ $VERSION =~ $FORMAT ]]; then
    echo "\033[31mERROR\033[0m: <version> does not match format $FORMAT"
    exit 1
fi

set -euo pipefail
mvn -f $WORKDIR/pom.xml versions:set \
    -DgenerateBackupPoms=false \
    -DnewVersion=$VERSION \
    -DprocessAllModules=true \
    -DprocessFromLocalAggregationRoot=false
