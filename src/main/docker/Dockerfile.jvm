FROM ghcr.io/installr-io/uci:jre21-1
LABEL org.opencontainers.image.source=https://github.com/installr-io/atrium

## We make four distinct layers so if there are application changes the library layers can be re-used
COPY --chown=${UCI_USERID} target/quarkus-app/lib/ /deployments/lib/
COPY --chown=${UCI_USERID} target/quarkus-app/*.jar /deployments/
COPY --chown=${UCI_USERID} target/quarkus-app/app/ /deployments/app/
COPY --chown=${UCI_USERID} target/quarkus-app/quarkus/ /deployments/quarkus/

## Set default port used by atrium
EXPOSE 9317

## Create directory which is used as a mount point
RUN mkdir -p $HOME/.atrium

## copy default configuration so atrium do not fail on start
COPY --chown=${UCI_USERID} target/non-packaged-resources/config/config.yaml /home/uci/.atrium/
COPY --chown=${UCI_USERID} target/non-packaged-resources/config/*.properties /home/uci/.atrium/

## Set environment
ENV JVM_OPTIONS=
ENV UCI_JRE_CUSTOM_OPTS=" \
-Dquarkus.http.host=0.0.0.0 \
-Djava.util.logging.manager=org.jboss.logmanager.LogManager \
${JVM_OPTIONS}"

## Run application
CMD [ "-jar", "/deployments/quarkus-run.jar" ]